// use prisma-8
enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

model User {
  id        Int                @id @default(autoincrement())
  email     String             @unique
  name      String             
  lastName  String?
  password  String
  role      Role               @default(USER)
  createdAt DateTime           @default(now()) @onCreate(now())
  updatedAt DateTime           @default(now()) @onUpdate(now())
  deletedAt DateTime?
  
  @@map("users")          
}